# Public base URL used in kid links, teacher links and QR codes
PUBLIC_URL=https://toyforge.chupa.nexus
# Host port nginx proxies to (bound to 127.0.0.1 only). Change if 3000 is taken.
HOST_PORT=3000
# Days of inactivity after which a class and all its models are deleted
RETENTION_DAYS=30
MAX_MODELS_PER_CLASS=500
